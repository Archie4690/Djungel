#!/bin/bash

PROFILES_DIR="$HOME/.config/profiles"
STATE_FILE="$PROFILES_DIR/.current"

list_profiles() {
    find "$PROFILES_DIR" -maxdepth 1 -mindepth 1 -type d -printf '%f\n' | sort
}

ensure_profile_layout() {
    local dir="$1"

    # Migrate legacy flat layout into folders if needed.
    if [[ ! -d "$dir/hypr" && -f "$dir/hyprland.conf" ]]; then
        mkdir -p "$dir/hypr"
        cp "$dir/hyprland.conf" "$dir/hypr/hyprland.conf"
    fi

    if [[ ! -d "$dir/waybar" ]]; then
        if [[ -f "$dir/config.jsonc" || -f "$dir/style.css" || -f "$dir/modules.jsonc" ]]; then
            mkdir -p "$dir/waybar"
            [[ -f "$dir/config.jsonc" ]] && cp "$dir/config.jsonc" "$dir/waybar/config.jsonc"
            [[ -f "$dir/style.css" ]] && cp "$dir/style.css" "$dir/waybar/style.css"
            [[ -f "$dir/modules.jsonc" ]] && cp "$dir/modules.jsonc" "$dir/waybar/modules.jsonc"
        fi
    fi

    if [[ ! -d "$dir/kitty" && -f "$dir/kitty.conf" ]]; then
        mkdir -p "$dir/kitty"
        cp "$dir/kitty.conf" "$dir/kitty/kitty.conf"
    fi
}

sync_live_to_profile() {
    local dir="$1"

    mkdir -p "$dir/hypr"
    if command -v rsync >/dev/null 2>&1; then
        rsync -a --delete "$HOME/.config/hypr/" "$dir/hypr/"
    else
        echo "Warning: rsync not found; hypr sync may leave stale files."
        cp -a "$HOME/.config/hypr/." "$dir/hypr/"
    fi

    mkdir -p "$dir/waybar"
    [[ -f "$HOME/.config/waybar/config.jsonc" ]] && cp "$HOME/.config/waybar/config.jsonc" "$dir/waybar/config.jsonc"
    [[ -f "$HOME/.config/waybar/style.css" ]] && cp "$HOME/.config/waybar/style.css" "$dir/waybar/style.css"
    [[ -f "$HOME/.config/waybar/modules.jsonc" ]] && cp "$HOME/.config/waybar/modules.jsonc" "$dir/waybar/modules.jsonc"

    if [[ -f "$HOME/.config/kitty/kitty.conf" ]]; then
        mkdir -p "$dir/kitty"
        cp "$HOME/.config/kitty/kitty.conf" "$dir/kitty/kitty.conf"
    fi
}

apply_profile_to_live() {
    local dir="$1"

    if [[ -d "$dir/hypr" ]]; then
        mkdir -p "$HOME/.config/hypr"
        if command -v rsync >/dev/null 2>&1; then
            rsync -a --delete "$dir/hypr/" "$HOME/.config/hypr/"
        else
            echo "Warning: rsync not found; hypr sync may leave stale files."
            cp -a "$dir/hypr/." "$HOME/.config/hypr/"
        fi
    elif [[ -f "$dir/hyprland.conf" ]]; then
        mkdir -p "$HOME/.config/hypr"
        cp "$dir/hyprland.conf" "$HOME/.config/hypr/hyprland.conf"
    fi

    if [[ -d "$dir/waybar" ]]; then
        mkdir -p "$HOME/.config/waybar"
        [[ -f "$dir/waybar/config.jsonc" ]] && cp "$dir/waybar/config.jsonc" "$HOME/.config/waybar/config.jsonc"
        [[ -f "$dir/waybar/style.css" ]] && cp "$dir/waybar/style.css" "$HOME/.config/waybar/style.css"
        [[ -f "$dir/waybar/modules.jsonc" ]] && cp "$dir/waybar/modules.jsonc" "$HOME/.config/waybar/modules.jsonc"
    else
        [[ -f "$dir/config.jsonc" ]] && cp "$dir/config.jsonc" "$HOME/.config/waybar/config.jsonc"
        [[ -f "$dir/style.css" ]] && cp "$dir/style.css" "$HOME/.config/waybar/style.css"
        [[ -f "$dir/modules.jsonc" ]] && cp "$dir/modules.jsonc" "$HOME/.config/waybar/modules.jsonc"
    fi

    if [[ -f "$dir/kitty/kitty.conf" ]]; then
        mkdir -p "$HOME/.config/kitty"
        cp "$dir/kitty/kitty.conf" "$HOME/.config/kitty/kitty.conf"
    elif [[ -f "$dir/kitty.conf" ]]; then
        mkdir -p "$HOME/.config/kitty"
        cp "$dir/kitty.conf" "$HOME/.config/kitty/kitty.conf"
    fi
}

# If no argument, show rofi picker
if [[ -z "${1:-}" ]]; then
    PROFILE=$(list_profiles | rofi -dmenu -p "Profile:")
    [[ -z "$PROFILE" ]] && exit 0
else
    PROFILE="$1"
fi

PROFILE_DIR="$PROFILES_DIR/$PROFILE"

if [[ ! -d "$PROFILE_DIR" ]]; then
    echo "Error: profile '$PROFILE' not found at $PROFILE_DIR"
    exit 1
fi

ensure_profile_layout "$PROFILE_DIR"

# Save live configs into the current profile before switching
if [[ -f "$STATE_FILE" ]]; then
    CURRENT=$(cat "$STATE_FILE")
    CURRENT_DIR="$PROFILES_DIR/$CURRENT"
    if [[ -d "$CURRENT_DIR" ]]; then
        ensure_profile_layout "$CURRENT_DIR"
        sync_live_to_profile "$CURRENT_DIR"
    fi
fi

# Copy new profile to live
apply_profile_to_live "$PROFILE_DIR"

echo "$PROFILE" > "$STATE_FILE"

hyprctl reload &>/dev/null
killall hyprpaper &>/dev/null && hyprpaper &>/dev/null &
killall waybar &>/dev/null && waybar &>/dev/null &
