# ─────────────────────────────
#  Archie • mako for Hyprland
#  Retro terminal — matches waybar / rofi
# ─────────────────────────────

# === Global style options (from man 5 mako) ===

font=DepartureMono Nerd Font Bold 11

background-color=#1c1c1cF5
text-color=#ebdbb2FF
progress-color=over #458588FF

width=360
height=120

outer-margin=20,20
margin=8
padding=10

border-size=1
border-color=#458588FF
border-radius=0

icons=1
max-icon-size=32
markup=1
history=1

text-alignment=left
group-by=app-name,summary
max-visible=5
layer=overlay
anchor=top-right

default-timeout=5000
ignore-timeout=0

format=<b>%s</b>\n%b

# === Urgency-specific styles (values from spec: low, normal, critical) ===

[urgency=low]
background-color=#1c1c1cF5
text-color=#928374FF
border-color=#504945FF
default-timeout=3000

[urgency=normal]
background-color=#282828F5
text-color=#ebdbb2FF
border-color=#458588FF
default-timeout=6000

[urgency=critical]
background-color=#282828FF
text-color=#ebdbb2FF
border-color=#cc241dFF
border-size=2
default-timeout=10000
ignore-timeout=0

# === Modes (do-not-disturb, compact, focus) ===
# Use: makoctl mode -a NAME   /   makoctl mode -r NAME

[mode=do-not-disturb]
invisible=1

[mode=compact]
font=DepartureMono Nerd Font Bold 10
width=260
padding=6
border-radius=0
format=<b>%s</b>

[mode=focus]
background-color=#1c1c1cF5
text-color=#ebdbb2FF
border-color=#83a598FF
default-timeout=2000
